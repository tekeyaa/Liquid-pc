{
  "name": "liquid-browser",
  "productName": "Liquid",
  "version": "1.35.1-beta",
  "description": "Минималистичный браузер в стиле liquid glass с VPN и Claude",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "get-xray": "node scripts/get-xray.js",
    "dist": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.liquid.browser",
    "productName": "Liquid",
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "main/**/*",
      "tools/rtx/gpu/train_gpu.py",
      "tools/rtx/gpu/rtxfmt.py",
      "tools/rtx/gpu/rtx2.py",
      "tools/rtx/gpu/rtx2_torch.py",
      "tools/rtx/gpu/check_rtx2.py",
      "vpn.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "renderer/icon.png",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.5.0"
  }
}
